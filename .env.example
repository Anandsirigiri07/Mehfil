# Server-side Gemini API key (Required for live Gemini calls in /api)
# The frontend client NEVER accesses this key directly.
# If unset or invalid, the backend automatically switches to offline rule-based fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Host environment / deployment origin for CSRF checks
# VERCEL_URL is automatically populated on Vercel deployments
ALLOWED_ORIGIN=http://localhost:5173

